  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-vue": "6.0.10",
    "vitest": "5.0.5",
    "prettier": "3.9.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.3"
  }
